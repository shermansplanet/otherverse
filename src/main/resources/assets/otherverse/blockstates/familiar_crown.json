{
  "multipart": [
    {
      "when": {
        "demesne": "false",
        "positive": "true"
      },
      "apply": {
        "model": "otherverse:block/familiar_crown"
      }
    },
    {
      "when": {
        "demesne": "false",
        "positive": "false"
      },
      "apply": {
        "model": "otherverse:block/negative_crown"
      }
    },
    {
      "when": {
        "demesne": "true"
      },
      "apply": {
        "model": "otherverse:block/demesne_crown"
      }
    }
  ]
}
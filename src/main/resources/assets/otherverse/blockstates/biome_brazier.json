{
  "multipart": [
    {
      "when": {
        "lit": "true"
      },
      "apply": {
        "model": "otherverse:block/biome_brazier_lit"
      }
    },
    {
      "when": {
        "scry": "true"
      },
      "apply": {
        "model": "otherverse:block/biome_brazier_scry"
      }
    },
    {
      "when": {
        "lit": "false",
        "scry": "false"
      },
      "apply": {
        "model": "otherverse:block/biome_brazier"
      }
    }
  ]
}
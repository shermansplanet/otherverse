{
    "multipart": [
        {   "when": {"chalk_circle" : "false", "chalk_n": "false", "chalk_ne": "false", "chalk_e": "false", "chalk_se": "false", "chalk_s": "false", "chalk_sw": "false", "chalk_w": "false", "chalk_nw": "false"},
            "apply": { "model": "testmod:block/chalk_dot"}
        },
        {   "when": { "chalk_n": "true", "chalk_circle" : "false" },
            "apply": { "model": "testmod:block/chalk_vertical", "y": 180}
        },
        {   "when": { "chalk_ne": "true", "chalk_circle" : "false" },
            "apply": { "model": "testmod:block/chalk_diagonal", "y": 270}
        },
        {   "when": { "chalk_e": "true", "chalk_circle" : "false" },
            "apply": { "model": "testmod:block/chalk_vertical", "y": 270}
        },
        {   "when": { "chalk_se": "true", "chalk_circle" : "false" },
            "apply": { "model": "testmod:block/chalk_diagonal"}
        },
        {   "when": { "chalk_s": "true", "chalk_circle" : "false" },
            "apply": { "model": "testmod:block/chalk_vertical"}
        },
        {   "when": { "chalk_sw": "true", "chalk_circle" : "false" },
            "apply": { "model": "testmod:block/chalk_diagonal", "y": 90}
        },
        {   "when": { "chalk_w": "true", "chalk_circle" : "false" },
            "apply": { "model": "testmod:block/chalk_vertical", "y": 90}
        },
        {   "when": { "chalk_nw": "true", "chalk_circle" : "false" },
            "apply": { "model": "testmod:block/chalk_diagonal", "y": 180}
        },
        {   "when": { "chalk_circle": "true" },
            "apply": { "model": "testmod:block/chalk_circle"}
        },
        {   "when": { "chalk_n": "true", "chalk_circle" : "true" },
            "apply": { "model": "testmod:block/chalk_vertical_short", "y": 180}
        },
        {   "when": { "chalk_ne": "true", "chalk_circle" : "true" },
            "apply": { "model": "testmod:block/chalk_diagonal_short", "y": 270}
        },
        {   "when": { "chalk_e": "true", "chalk_circle" : "true" },
            "apply": { "model": "testmod:block/chalk_vertical_short", "y": 270}
        },
        {   "when": { "chalk_se": "true", "chalk_circle" : "true" },
            "apply": { "model": "testmod:block/chalk_diagonal_short"}
        },
        {   "when": { "chalk_s": "true", "chalk_circle" : "true" },
            "apply": { "model": "testmod:block/chalk_vertical_short"}
        },
        {   "when": { "chalk_sw": "true", "chalk_circle" : "true" },
            "apply": { "model": "testmod:block/chalk_diagonal_short", "y": 90}
        },
        {   "when": { "chalk_w": "true", "chalk_circle" : "true" },
            "apply": { "model": "testmod:block/chalk_vertical_short", "y": 90}
        },
        {   "when": { "chalk_nw": "true", "chalk_circle" : "true" },
            "apply": { "model": "testmod:block/chalk_diagonal_short", "y": 180}
        }
    ]
}